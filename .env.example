DEEPSEEK_API_KEY=your-key-here

# Days of articles to retain in public/news.json. Default: 30.
RETENTION_DAYS=30

# Maximum new canonical articles classified in one ingest run. Default: 100.
# Each admitted article costs one DeepSeek classification slot (batches of 25),
# so this is the single lever that bounds a run's model spend. It is a per-run
# volume ceiling, not a daily budget: overflow is skipped and logged, not queued.
MAX_NEW_ARTICLES_PER_RUN=100

# Consecutive failed runs before a feed is labelled persistently failing in the
# UI. Default: 3. Feeds below the threshold still appear in the existing failure
# counts; this only adds the persistent label.
FEED_FAILURE_WARNING_THRESHOLD=3

# Public presentation flag. Only the exact value true enables the Extra edition.
VITE_ENABLE_EXTRA=false

# Personal delivery is opt-in. Never use VITE_ prefixes for these values.
TELEGRAM_ENABLED=false
# Summary language: zh-HK (default when unset/blank) or en.
TELEGRAM_LANGUAGE=zh-HK
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local sending/status/recovery only. GitHub Actions supplies these automatically.
# Use a fine-grained token restricted to this repo: Contents read and write.
GITHUB_REPOSITORY=marco144803025/AI-News-Reader
GITHUB_TOKEN=
